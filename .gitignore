# Credentials: the inventory carries the account id and node keys, the identity
# file carries the signing key. Neither may ever be committed.
nodes.json
*-identity.json
*-state.json
*-pins.json

# Build output and local artefacts. These are anchored to the repository root:
# an unanchored "tunnet-lite" also matches the npm/tunnet-lite directory, which
# silently kept the launcher package out of the last commit.
/tunnet-lite
/tunnet-lite.exe
/access2nodes
/access2nodes.exe
*.exe
*.exe~
*.log
.ctltest/

# Rule sets are fetched, not vendored: tools/fetch-rules.sh
assets/
*.dat
*.sha256sum

# npm packaging output
.npmdist/
dist/
*.tgz
.xbuild/
